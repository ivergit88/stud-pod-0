# Локальный порт Express-сервера
PORT=3000

# Секрет для cookie-сессий. Перед продом обязательно заменить на длинное случайное значение.
JWT_SECRET=change-me-before-production

# Для локального запуска на http оставьте false.
COOKIE_SECURE=false

# API-ключ YandexGPT
YANDEXGPT_API_KEY=

# Folder ID в Yandex Cloud, где подключен YandexGPT
YANDEX_FOLDER_ID=

# Ключ JavaScript API Яндекс.Карт
VITE_YANDEX_MAPS_API_KEY=

# Ключ Suggest API Яндекс.Карт.
# Можно использовать тот же ключ, если он выпущен с нужными правами.
VITE_YANDEX_MAPS_SUGGEST_API_KEY=

# Временный пароль для импортируемых пользователей из старой системы.
# После разового импорта измените значение или удалите переменную.
MIGRATION_DEFAULT_PASSWORD=StudPod2026!
