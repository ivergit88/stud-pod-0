{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Stud Pod: Local Dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Stud Pod: Fetch Prod Env",
      "type": "shell",
      "command": "./scripts/fetch-beget-env.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Stud Pod: Deploy To Beget",
      "type": "shell",
      "command": "./scripts/deploy-beget.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Stud Pod: Configure Domain",
      "type": "shell",
      "command": "./scripts/configure-beget-domain.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
