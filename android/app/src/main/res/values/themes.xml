<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Стартовый экран (core-splashscreen): показывается до первой Compose-отрисовки -->
    <style name="Theme.StudPod" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/portal_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.StudPod.Main</item>
    </style>

    <!-- Основная тема после сплэша -->
    <style name="Theme.StudPod.Main" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/portal_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/portal_bg</item>
    </style>
</resources>
